# Environment variables for BlueprintGenerator Declarative Agent
# This file is committed to git — do NOT put secrets here.
# Secrets go in .env.dev.user (gitignored)

TEAMSFX_ENV=dev
APP_NAME_SUFFIX=

# URL base dell'Azure Function — da aggiornare dopo il deploy
# Es: https://blueprint-func-enel.azurewebsites.net
BLUEPRINT_API_BASE_URL=https://YOUR_AZURE_FUNCTION.azurewebsites.net

# Generati automaticamente da "Provision" — non modificare manualmente
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=
BLUEPRINT_API_KEY_REFERENCE_ID=
