# .env.dev.user — SEGRETI LOCALI — NON committare su Git
# Contiene le chiavi segrete per l'ambiente dev.

# API key per proteggere le chiamate all'Azure Function
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
BLUEPRINT_API_KEY=CAMBIA_CON_CHIAVE_SICURA

# Azure OpenAI (necessario per blueprint_engine.py)
AZURE_OPENAI_ENDPOINT=https://YOUR_OPENAI.openai.azure.com/
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# SharePoint / Microsoft Graph (app registration con Sites.Read.All)
AZURE_TENANT_ID=d539d4bf-5610-471a-afc2-1c76685cfefa
AZURE_CLIENT_ID=YOUR_APP_REGISTRATION_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_APP_REGISTRATION_SECRET
SHAREPOINT_SITE_URL=https://enelitalia.sharepoint.com/sites/AIScaleUp

# Percorso del template Blueprint su Azure Blob (o percorso locale per test)
BLUEPRINT_TEMPLATE_URL=https://YOUR_STORAGE.blob.core.windows.net/templates/Blueprint_1.3_enhanced.docx
