# .env.dev.user.example — ESEMPIO SANIFICATO — NON usare valori reali nel repository
# Questo file contiene solo placeholder e non deve includere segreti o identificativi reali.

# API key per proteggere le chiamate all'Azure Function
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
BLUEPRINT_API_KEY=YOUR_SECURE_BLUEPRINT_API_KEY

# Azure OpenAI (necessario per blueprint_engine.py)
AZURE_OPENAI_ENDPOINT=https://YOUR_AZURE_OPENAI_RESOURCE.openai.azure.com/
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=YOUR_AZURE_OPENAI_DEPLOYMENT

# SharePoint / Microsoft Graph (app registration con Sites.Read.All)
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
AZURE_CLIENT_ID=YOUR_APP_REGISTRATION_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_APP_REGISTRATION_CLIENT_SECRET
SHAREPOINT_SITE_URL=https://YOUR_TENANT.sharepoint.com/sites/YOUR_SITE_NAME

# Percorso del template Blueprint su Azure Blob (o percorso locale per test)
BLUEPRINT_TEMPLATE_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/templates/YOUR_TEMPLATE_FILE.docx
