{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.3",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "BluePrint2.0${{APP_NAME_SUFFIX}}",
        "full": "Full name for BluePrint2.0"
    },
    "description": {
        "short": "Genera Blueprint Enel-GICT da documenti SharePoint",
        "full": "Agente AI che analizza materiali di progetto (PPTX, PDF, DOCX) da SharePoint/OneDrive e produce il contenuto strutturato per documenti Blueprint conformi al framework Blueprint 1.0 Enel-GICT."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": []
}