{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "AISA Factory — Enel",
        "websiteUrl": "https://www.enel.com",
        "privacyUrl": "https://www.enel.com/privacy",
        "termsOfUseUrl": "https://www.enel.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "BlueprintGenerator",
        "full": "BlueprintGenerator — AISA Factory Enel"
    },
    "description": {
        "short": "Genera Blueprint Enel-GICT da materiali di progetto",
        "full": "Agente AI che genera automaticamente documenti Blueprint (.docx) conformi al framework Blueprint 1.0 Enel-GICT, partendo da materiali di progetto (PPTX, PDF, DOCX) su SharePoint."
    },
    "accentColor": "#002060",
    "copilotAgents": {
        "declarativeAgents": [
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}
